# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
# The port the application will run on locally
PORT=3000

# The environment the app is running in (development, production, test)
NODE_ENV=development

# ==============================================================================
# SECURITY & AUTHENTICATION
# ==============================================================================
# A secret string used to sign JSON Web Tokens (JWT)
# Generate a random string for your local .env
JWT_SECRET=your_super_secret_random_string_here

# ==============================================================================
# DATABASE CONFIGURATION (Future Setup)
# ==============================================================================
# Connection string for your database
# Example: postgres://username:password@localhost:5432/database_name
DATABASE_URL=your_database_url_here

# ==============================================================================
# EXTERNAL SERVICES
# ==============================================================================
# Example: If you use a service like Stripe or AWS
# STRIPE_API_KEY=sk_test_...
# AWS_REGION=us-east-1